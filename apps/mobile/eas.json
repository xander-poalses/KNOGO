{
  "cli": { "version": ">= 22.0.0", "appVersionSource": "remote" },
  "build": {
    "development": { "developmentClient": true, "distribution": "internal", "environment": "development" },
    "preview": { "distribution": "internal", "environment": "preview", "android": { "buildType": "apk" }, "uploadSourceMaps": true },
    "testing": { "distribution": "store", "autoIncrement": true, "environment": "preview", "env": { "EXPO_PUBLIC_APP_ENV": "testing", "EXPO_PUBLIC_USE_MOCK_DATA": "false", "SENTRY_DISABLE_AUTO_UPLOAD": "true" }, "android": { "buildType": "app-bundle" }, "uploadSourceMaps": true },
    "production": { "autoIncrement": true, "environment": "production", "env": { "EXPO_PUBLIC_APP_ENV": "production", "EXPO_PUBLIC_USE_MOCK_DATA": "false" }, "android": { "buildType": "app-bundle" }, "uploadSourceMaps": true }
  },
  "submit": { "production": {} }
}
