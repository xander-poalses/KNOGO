{
  "expo": {
    "name": "KNOGO",
    "slug": "knogo",
    "version": "0.2.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "scheme": "knogo",
    "userInterfaceStyle": "automatic",
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "icon": "./assets/icon.png",
    "android": {
      "package": "za.co.knogo.app",
      "versionCode": 8,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f3f3e8"
      }
    },
    "plugins": [
      "@rnmapbox/maps",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-mascot.png",
          "imageWidth": 44,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow KNOGO to estimate trips from your location and find places near you. Your location is not used to verify contributions."
        }
      ],
      "expo-image",
      "@sentry/react-native",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "supabaseUrl": "",
      "supabasePublishableKey": "",
      "router": {},
      "eas": {
        "projectId": "0e258bea-a78c-4222-b430-75e87b85431b"
      }
    },
    "owner": "xanderpoalses"
  }
}
